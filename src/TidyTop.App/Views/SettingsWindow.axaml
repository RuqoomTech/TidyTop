<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TidyTop.App.Views.SettingsWindow"
        Title="TidyTop Settings"
        Width="520"
        Height="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FF151719">

    <Grid Margin="24" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,18">
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Settings are intentionally limited while the MVP core loop is being built." Foreground="#FF9EAAB4" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="12">
            <TextBlock Text="Planned for the next milestones:" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="• Create, rename, delete, collapse, and color SmartBoxes" Foreground="#FFD7DEE5"/>
            <TextBlock Text="• Save and restore layout JSON" Foreground="#FFD7DEE5"/>
            <TextBlock Text="• Configure quick hide/show hotkey" Foreground="#FFD7DEE5"/>
            <TextBlock Text="• Enable/disable auto-categorization rules" Foreground="#FFD7DEE5"/>
            <TextBlock Text="• Start with Windows option" Foreground="#FFD7DEE5"/>
        </StackPanel>

        <Button Grid.Row="2"
                Content="Close"
                HorizontalAlignment="Right"
                Padding="20,10"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
