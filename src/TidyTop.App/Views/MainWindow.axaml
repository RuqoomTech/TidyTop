<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TidyTop.App.ViewModels"
        mc:Ignorable="d"
        x:Class="TidyTop.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TidyTop"
        Width="1280"
        Height="820"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Background="Transparent">

    <Grid ClipToBounds="False" Background="Transparent">
        <ItemsControl Classes="smart-box-layer"
                      ItemsSource="{Binding SmartBoxes}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.Styles>
                <Style Selector="ItemsControl.smart-box-layer > ContentPresenter" x:DataType="vm:SmartBoxViewModel">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    <Setter Property="IsVisible" Value="{Binding IsVisible}"/>
                </Style>
            </ItemsControl.Styles>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SmartBoxViewModel">
                    <Border Width="{Binding Width}"
                            Height="{Binding Height}"
                            CornerRadius="18"
                            BorderThickness="1"
                            BorderBrush="#55FFFFFF"
                            Background="#D7101724"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="17,17,0,0"
                                    Padding="12,9"
                                    Cursor="SizeAll"
                                    PointerPressed="OnSmartBoxHeaderPointerPressed"
                                    PointerMoved="OnSmartBoxInteractionPointerMoved"
                                    PointerReleased="OnSmartBoxInteractionPointerReleased"
                                    PointerCaptureLost="OnSmartBoxInteractionPointerCaptureLost">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Emoji}" FontSize="15" VerticalAlignment="Center"/>
                                        <StackPanel Spacing="0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="drag header to move"
                                                       Foreground="#E2E8F0"
                                                       FontSize="9"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="#2AFFFFFF"
                                            CornerRadius="999"
                                            Padding="8,3"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ItemCount}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" RowDefinitions="Auto,*">
                                <Border Grid.Row="0"
                                        Background="#221E293B"
                                        BorderBrush="#22334155"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,7">
                                    <TextBlock Text="Double-click to open • drag item to another box"
                                               Foreground="#CBD5E1"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <Grid Grid.Row="1">
                                    <ScrollViewer Padding="10"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DesktopItemViewModel">
                                                    <Border CornerRadius="12"
                                                            Background="#22FFFFFF"
                                                            BorderBrush="#22FFFFFF"
                                                            BorderThickness="1"
                                                            Padding="9,7"
                                                            Margin="0,0,0,7"
                                                            Cursor="Hand"
                                                            ToolTip.Tip="{Binding FullPath}"
                                                            DoubleTapped="OnDesktopItemDoubleTapped"
                                                            PointerPressed="OnDesktopItemPointerPressed"
                                                            PointerMoved="OnDesktopItemPointerMoved"
                                                            PointerReleased="OnDesktopItemPointerReleased"
                                                            PointerCaptureLost="OnDesktopItemPointerCaptureLost">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                            <Border Width="28"
                                                                    Height="28"
                                                                    CornerRadius="9"
                                                                    Background="#1EFFFFFF"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icon}"
                                                                           FontSize="16"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="White"
                                                                           FontSize="12"
                                                                           FontWeight="Medium"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding FullPath}"
                                                                           Foreground="#94A3B8"
                                                                           FontSize="9"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2"
                                                                        Spacing="4"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Right">
                                                                <Border Background="#1AFFFFFF"
                                                                        CornerRadius="999"
                                                                        Padding="7,3"
                                                                        HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding Subtitle}"
                                                                               Foreground="#CBD5E1"
                                                                               FontSize="9"/>
                                                                </Border>
                                                                <Button Content="Open"
                                                                        FontSize="10"
                                                                        Padding="8,3"
                                                                        HorizontalAlignment="Right"
                                                                        Click="OnDesktopItemOpenClick"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Border IsVisible="{Binding IsEmpty}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="18"
                                            CornerRadius="16"
                                            Background="#1AFFFFFF"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            Padding="16,14">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="Drop items here"
                                                       Foreground="White"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding EmptyText}"
                                                       Foreground="#94A3B8"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       MaxWidth="210"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Border Grid.RowSpan="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Width="26"
                                    Height="26"
                                    Margin="0,0,4,4"
                                    CornerRadius="9"
                                    Background="#CC0F172A"
                                    BorderBrush="#66FFFFFF"
                                    BorderThickness="1"
                                    Cursor="BottomRightCorner"
                                    PointerPressed="OnSmartBoxResizePointerPressed"
                                    PointerMoved="OnSmartBoxInteractionPointerMoved"
                                    PointerReleased="OnSmartBoxInteractionPointerReleased"
                                    PointerCaptureLost="OnSmartBoxInteractionPointerCaptureLost">
                                <TextBlock Text="↘"
                                           Foreground="White"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="18"
                CornerRadius="22"
                Background="#DD0F172A"
                BorderBrush="#334155"
                BorderThickness="1"
                Padding="14,11">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="🧹 TidyTop"
                           Foreground="White"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border Background="#14233445" Width="1" Height="22"/>
                <TextBlock Text="{Binding SummaryText}"
                           Foreground="#CBD5E1"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <Button Content="Refresh" Padding="10,6" Command="{Binding RefreshCommand}"/>
                <Button Content="Add box" Padding="10,6" Command="{Binding AddSmartBoxCommand}"/>
                <Button Content="Save" Padding="10,6" Command="{Binding SaveLayoutCommand}"/>
                <Button Content="Reset" Padding="10,6" Command="{Binding ResetLayoutCommand}"/>
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="18"
                CornerRadius="16"
                Background="#DD0F172A"
                BorderBrush="#334155"
                BorderThickness="1"
                Padding="13,9">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="●" Foreground="#22C55E"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" IsVisible="{Binding HasError}"/>
            </StackPanel>
        </Border>

        <Grid Background="#33000000" IsVisible="{Binding IsBusy}">
            <Border Background="#E6111827"
                    CornerRadius="18"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="🔄" FontSize="22"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
