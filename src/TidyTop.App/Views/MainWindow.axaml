<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TidyTop.App.ViewModels"
        mc:Ignorable="d"
        x:Class="TidyTop.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TidyTop"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        Background="#0F172A">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="🧹" FontSize="30" VerticalAlignment="Center"/>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="Refresh" Padding="14,8" Command="{Binding RefreshCommand}"/>
                    <Button Content="Add SmartBox" Padding="14,8" Command="{Binding AddSmartBoxCommand}"/>
                    <Button Content="Save" Padding="14,8" Command="{Binding SaveLayoutCommand}"/>
                    <Button Content="Reset" Padding="14,8" Command="{Binding ResetLayoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SmartBoxes}" Margin="18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SmartBoxViewModel">
                        <Border Width="340"
                                Height="286"
                                Margin="8"
                                CornerRadius="16"
                                BorderThickness="1"
                                BorderBrush="{Binding AccentBrush}"
                                Background="#182235">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0"
                                        Background="{Binding AccentBrush}"
                                        CornerRadius="15,15,0,0"
                                        Padding="14,11">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding HeaderText}"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Behavior}"
                                                   FontSize="11"
                                                   Foreground="#E2E8F0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" Padding="12" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DesktopItemViewModel">
                                                <Border CornerRadius="10"
                                                        Background="#14FFFFFF"
                                                        Padding="9,7"
                                                        Margin="0,0,0,7">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                        <TextBlock Text="{Binding Icon}" FontSize="17" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="White"
                                                                       FontSize="13"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding FullPath}"
                                                                       Foreground="#64748B"
                                                                       FontSize="10"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Subtitle}"
                                                                   Foreground="#CBD5E1"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" IsVisible="{Binding HasError}"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding SummaryText}"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.RowSpan="3" Background="#99000000" IsVisible="{Binding IsBusy}">
            <Border Background="#111827"
                    CornerRadius="14"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="🔄" FontSize="22"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
