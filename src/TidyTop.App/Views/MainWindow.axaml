<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TidyTop.App.ViewModels"
        mc:Ignorable="d"
        x:Class="TidyTop.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TidyTop"
        Width="1280"
        Height="820"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Background="Transparent">

    <Grid ClipToBounds="False" Background="Transparent">
        <ItemsControl Classes="smart-box-layer"
              ItemsSource="{Binding SmartBoxes}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.Styles>
               <Style Selector="ItemsControl.smart-box-layer > ContentPresenter"
       		    x:DataType="vm:SmartBoxViewModel">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    <Setter Property="IsVisible" Value="{Binding IsVisible}"/>
                </Style>
            </ItemsControl.Styles>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SmartBoxViewModel">
                    <Border Width="{Binding Width}"
                            Height="{Binding Height}"
                            CornerRadius="14"
                            BorderThickness="1"
                            BorderBrush="{Binding AccentBrush}"
                            Background="#D9162436"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="13,13,0,0"
                                    Padding="12,9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding HeaderText}"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Behavior}"
                                               FontSize="10"
                                               Foreground="#E2E8F0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          Padding="10"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DesktopItemViewModel">
                                            <Border CornerRadius="9"
                                                    Background="#1AFFFFFF"
                                                    Padding="8,6"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding Icon}"
                                                               FontSize="16"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="White"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding FullPath}"
                                                                   Foreground="#94A3B8"
                                                                   FontSize="9"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Subtitle}"
                                                               Foreground="#CBD5E1"
                                                               FontSize="9"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16"
                CornerRadius="18"
                Background="#CC0F172A"
                BorderBrush="#334155"
                BorderThickness="1"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="🧹 TidyTop"
                           Foreground="White"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SummaryText}"
                           Foreground="#CBD5E1"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <Button Content="Refresh" Padding="10,6" Command="{Binding RefreshCommand}"/>
                <Button Content="Add" Padding="10,6" Command="{Binding AddSmartBoxCommand}"/>
                <Button Content="Save" Padding="10,6" Command="{Binding SaveLayoutCommand}"/>
                <Button Content="Reset" Padding="10,6" Command="{Binding ResetLayoutCommand}"/>
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="16"
                CornerRadius="14"
                Background="#CC0F172A"
                BorderBrush="#334155"
                BorderThickness="1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" IsVisible="{Binding HasError}"/>
            </StackPanel>
        </Border>

        <Grid Background="#33000000" IsVisible="{Binding IsBusy}">
            <Border Background="#E6111827"
                    CornerRadius="14"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="🔄" FontSize="22"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
