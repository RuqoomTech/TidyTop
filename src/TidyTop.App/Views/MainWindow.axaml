<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TidyTop.App.ViewModels"
        mc:Ignorable="d"
        x:Class="TidyTop.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TidyTop"
        Width="1280"
        Height="820"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="Button.toolbar-button">
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#223244"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.icon-button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#263449"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid ClipToBounds="False" Background="Transparent">
        <ItemsControl Classes="smart-box-layer"
                      ItemsSource="{Binding SmartBoxes}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.Styles>
                <Style Selector="ItemsControl.smart-box-layer > ContentPresenter" x:DataType="vm:SmartBoxViewModel">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    <Setter Property="IsVisible" Value="{Binding IsVisible}"/>
                </Style>
            </ItemsControl.Styles>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SmartBoxViewModel">
                    <Border Width="{Binding Width}"
                            Height="{Binding Height}"
                            CornerRadius="16"
                            BorderThickness="1"
                            BorderBrush="#36FFFFFF"
                            Background="#CC08111F"
                            ClipToBounds="True">
                        <Grid RowDefinitions="3,Auto,*">
                            <Border Grid.Row="0" Background="{Binding AccentBrush}"/>

                            <Border Grid.Row="1"
                                    Background="#66101A2B"
                                    Padding="11,9"
                                    Cursor="SizeAll"
                                    PointerPressed="OnSmartBoxHeaderPointerPressed"
                                    PointerMoved="OnSmartBoxInteractionPointerMoved"
                                    PointerReleased="OnSmartBoxInteractionPointerReleased"
                                    PointerCaptureLost="OnSmartBoxInteractionPointerCaptureLost">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Width="32"
                                            Height="32"
                                            CornerRadius="10"
                                            Background="#18FFFFFF"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Emoji}"
                                                   FontSize="15"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#F8FAFC"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding BoxSubtitle}"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="#18FFFFFF"
                                            CornerRadius="999"
                                            Padding="8,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ItemCount}"
                                                   Foreground="#F8FAFC"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <ScrollViewer Padding="10,9,10,10"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DesktopItemViewModel">
                                                <Border CornerRadius="13"
                                                        Background="#2B172033"
                                                        BorderBrush="#1FFFFFFF"
                                                        BorderThickness="1"
                                                        Padding="8"
                                                        Margin="0,0,0,8"
                                                        Cursor="Hand"
                                                        ToolTip.Tip="{Binding FullPath}"
                                                        DoubleTapped="OnDesktopItemDoubleTapped"
                                                        PointerPressed="OnDesktopItemPointerPressed"
                                                        PointerMoved="OnDesktopItemPointerMoved"
                                                        PointerReleased="OnDesktopItemPointerReleased"
                                                        PointerCaptureLost="OnDesktopItemPointerCaptureLost">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                        <Border Width="34"
                                                                Height="34"
                                                                CornerRadius="11"
                                                                Background="#16FFFFFF"
                                                                BorderBrush="#1FFFFFFF"
                                                                BorderThickness="1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Icon}"
                                                                       FontSize="17"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="#F8FAFC"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding DetailsText}"
                                                                       Foreground="#94A3B8"
                                                                       FontSize="10"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="2"
                                                                Classes="icon-button"
                                                                Content="↗"
                                                                ToolTip.Tip="Open"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Click="OnDesktopItemOpenClick"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border IsVisible="{Binding IsEmpty}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="18"
                                        CornerRadius="16"
                                        Background="#161E293B"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        Padding="18,16">
                                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                                        <TextBlock Text="Drop items here"
                                                   Foreground="#F8FAFC"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding EmptyText}"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="220"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.RowSpan="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,5,5"
                                    CornerRadius="8"
                                    Background="#D00F172A"
                                    BorderBrush="#3DFFFFFF"
                                    BorderThickness="1"
                                    Cursor="BottomRightCorner"
                                    ToolTip.Tip="Resize"
                                    PointerPressed="OnSmartBoxResizePointerPressed"
                                    PointerMoved="OnSmartBoxInteractionPointerMoved"
                                    PointerReleased="OnSmartBoxInteractionPointerReleased"
                                    PointerCaptureLost="OnSmartBoxInteractionPointerCaptureLost">
                                <TextBlock Text="◢"
                                           Foreground="#CBD5E1"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="18"
                CornerRadius="22"
                Background="#E00B1220"
                BorderBrush="#2FFFFFFF"
                BorderThickness="1"
                Padding="12,9">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="12" Background="#1EFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                    <TextBlock Text="🧹" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="TidyTop" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SummaryText}" Foreground="#94A3B8" FontSize="10"/>
                </StackPanel>
                <Border Background="#253244" Width="1" Height="28" Margin="4,0"/>
                <Button Classes="toolbar-button" Content="Refresh" Command="{Binding RefreshCommand}"/>
                <Button Classes="toolbar-button" Content="Add box" Command="{Binding AddSmartBoxCommand}"/>
                <Button Classes="toolbar-button" Content="Auto layout" Click="OnAutoArrangeClick"/>
                <Button Classes="toolbar-button" Content="Save" Command="{Binding SaveLayoutCommand}"/>
                <Button Classes="toolbar-button" Content="Reset" Command="{Binding ResetLayoutCommand}"/>
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="18"
                CornerRadius="16"
                Background="#D00B1220"
                BorderBrush="#2FFFFFFF"
                BorderThickness="1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <TextBlock Text="●" Foreground="#22C55E"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1" FontSize="12"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontSize="12" IsVisible="{Binding HasError}"/>
            </StackPanel>
        </Border>

        <Grid Background="#33000000" IsVisible="{Binding IsBusy}">
            <Border Background="#E6111827"
                    CornerRadius="18"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="🔄" FontSize="22"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
